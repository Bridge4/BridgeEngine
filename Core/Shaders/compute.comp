#version 430 core

// Define the local workgroup size (X, Y, Z dimensions)
// A size of (128, 1, 1) means this group processes 128 items in parallel
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

// Input buffer (Read-Only)
layout(std430, binding = 0) readonly buffer InputBuffer {
    float dataIn[];
};

// Output buffer (Write-Only)
layout(std430, binding = 1) writeonly buffer OutputBuffer {
    float dataOut[];
};

void main() {
    // Determine the unique global index of the current thread invocation
    uint index = gl_GlobalInvocationID.x;

    // Simple mathematical operation to test processing
    dataOut[index] = dataIn[index] * 2.0;
}
