// This compute shader contains a GLSL implementation of Improved Perlin Noise
// https://mrl.cs.nyu.edu/~perlin/noise/
#version 430 core

// Define the local workgroup size (X, Y, Z dimensions)
// A size of (128, 1, 1) means this group processes 128 items in parallel
layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;

// Optional Input Buffer
layout(std430, binding = 0) readonly buffer InputBuffer {
    float dataIn[];
};
struct Vertex {
    float px, py, pz, _p0;   // offset  0
    float cr, cg, cb, _p1;   // offset 16
    float nx, ny, nz, _p2;   // offset 32
    float tu, tv, _p3, _p4;  // offset 48
};                           // 64 bytes

// We will write to the dataOut buffer, the vertex data of our high resolution landscape mesh
layout(std430, binding = 1) writeonly buffer OutputBuffer {
    Vertex dataOut[];
};

// === IMPROVED PERLIN NOISE IMPLMENTATION === //
float fade(float t) {
  return t * t * t * (t * (t * 6 - 15) + 10);
}
int p[] = { 
  151,160,137,91,90,15,
  131,13,201,95,96,53,194,233,7,225,140,36,103,30,69,142,8,99,37,240,21,10,23,
  190, 6,148,247,120,234,75,0,26,197,62,94,252,219,203,117,35,11,32,57,177,33,
  88,237,149,56,87,174,20,125,136,171,168, 68,175,74,165,71,134,139,48,27,166,
  77,146,158,231,83,111,229,122,60,211,133,230,220,105,92,41,55,46,245,40,244,
  102,143,54, 65,25,63,161, 1,216,80,73,209,76,132,187,208, 89,18,169,200,196,
  135,130,116,188,159,86,164,100,109,198,173,186, 3,64,52,217,226,250,124,123,
  5,202,38,147,118,126,255,82,85,212,207,206,59,227,47,16,58,17,182,189,28,42,
  223,183,170,213,119,248,152, 2,44,154,163, 70,221,153,101,155,167, 43,172,9,
  129,22,39,253, 19,98,108,110,79,113,224,232,178,185, 112,104,218,246,97,228,
  251,34,242,193,238,210,144,12,191,179,162,241, 81,51,145,235,249,14,239,107,
  49,192,214, 31,181,199,106,157,184, 84,204,176,115,121,50,45,127, 4,150,254,
  138,236,205,93,222,114,67,29,24,72,243,141,128,195,78,66,215,61,156,180
};

int perm(int i) { return p[i & 255]; }

float lerp(float t, float a, float b) { return a + t * (b - a); }

float grad(int hash, float x, float y, float z) { 
  int h = hash & 15;
  float u = h < 8 ? x : y;
  float v = h < 4 ? y : h == 2 || h == 14 ? x : z;
  return ((h&1) == 0 ? u : -u) + ((h&2) == 0 ? v : -v);
}

float ImprovedPerlinNoise3D (float x, float y, float z) {
  // Find unit cube that contains point
  int X = int(floor(x)) & 255; // extract lowest 8 bits by doing a bitwise & op with 255
  int Y = int(floor(y)) & 255;
  int Z = int(floor(z)) & 255;

  // Find relative xyz of point in cube
  x -= floor(x); 
  y -= floor(y);
  z -= floor(z);

  // Compute fade curves for each xyz
  float u = fade(x);
  float v = fade(y);
  float w = fade(z);

  // Hash coordinates of the 8 cube corners
  int A = perm(X) + Y;
  int AA = perm(A) + Z;
  int AB = perm(A + 1) + Z;
  int B = perm(X + 1) + Y;
  int BA = perm(B) + Z;
  int BB = perm(B + 1) + Z;

  // Add blended results from the 8 corners of the cube
  return 
          lerp(w, lerp(v, lerp(u, grad(perm(AA  ), x  , y  , z   ),  // AND ADD
                                  grad(perm(BA  ), x-1, y  , z   )), // BLENDED
                          lerp(u, grad(perm(AB  ), x  , y-1, z   ),  // RESULTS
                                  grad(perm(BB  ), x-1, y-1, z   ))),// FROM  8
                  lerp(v, lerp(u, grad(perm(AA+1), x  , y  , z-1 ),  // CORNERS
                                  grad(perm(BA+1), x-1, y  , z-1 )), // OF CUBE
                          lerp(u, grad(perm(AB+1), x  , y-1, z-1 ),
                                  grad(perm(BB+1), x-1, y-1, z-1 ))));
}

float Perlin2D (float x, float z) {
  return ImprovedPerlinNoise3D(x, 0.37, z);
}

float terrainHeight(float gx, float gy) {
    vec2 base = vec2(gx, gy) * 0.01 + vec2(dataIn[0], dataIn[1]);
    float sum = 0.0, amp = 1.0, freq = 1.0, norm = 0.0;
    for (int i = 0; i < 5; ++i) {
        sum  += amp * ImprovedPerlinNoise3D(base.x * freq, 0.37 + dataIn[2], base.y * freq);
        norm += amp;
        amp  *= 0.5;
        freq *= 2.0;
    }
    return (sum / norm) * 40.0;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    const uint gridWidth  = 1024;
    const uint gridHeight = 1024;
    if (idx >= gridWidth * gridHeight) return;

    const float meshScale = 200.0;
    uint x = idx % gridWidth;
    uint y = idx / gridWidth;

    float u = float(x) / float(gridWidth  - 1);
    float v = float(y) / float(gridHeight - 1);

    float fx = float(x), fy = float(y);
    float h  = terrainHeight(fx, fy);

    // central differences, one grid step = cell world size
    float cell = meshScale / float(gridWidth - 1);
    float hL = terrainHeight(fx - 1.0, fy);
    float hR = terrainHeight(fx + 1.0, fy);
    float hD = terrainHeight(fx, fy - 1.0);
    float hU = terrainHeight(fx, fy + 1.0);
    vec3 n = normalize(vec3(hL - hR, 2.0 * cell, hD - hU));

    dataOut[idx].px = (u - 0.5) * meshScale;
    dataOut[idx].py = h;
    dataOut[idx].pz = (v - 0.5) * meshScale;
    dataOut[idx].cr = 1.0; dataOut[idx].cg = 1.0; dataOut[idx].cb = 1.0;
    dataOut[idx].nx = n.x; dataOut[idx].ny = n.y; dataOut[idx].nz = n.z;
    dataOut[idx].tu = u;
    dataOut[idx].tv = v;
}
